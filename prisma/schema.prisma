// Saucer Database Foundation — Phase 2: Gemini AI Engine & Credit Ledger
// Provider: Supabase PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum WorkspaceRole {
  ADMIN
  EDITOR
  VIEWER
}

enum SubscriptionTier {
  FREE
  PRO
  AGENCY
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  HALTED
  CANCELLED
  TRIALING
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum ReservationStatus {
  RESERVED
  COMMITTED
  RELEASED
  EXPIRED
  RECONCILIATION_REQUIRED
}

enum LedgerEntryType {
  ALLOWANCE_GRANT
  PURCHASE_GRANT
  RESERVATION_HOLD
  SETTLEMENT_DEBIT
  REFUND_CREDIT
  EXPIRATION_RELEASE
  MONTHLY_RESET
}

model Profile {
  id                  String               @id @default(uuid())
  supabaseUserId      String               @unique
  email               String               @unique
  fullName            String?
  avatarUrl           String?
  timezone            String               @default("UTC")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organizationMembers OrganizationMember[]
  workspaceMembers    WorkspaceMember[]

  @@index([supabaseUserId])
  @@index([email])
}

model Organization {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  logoUrl               String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  members               OrganizationMember[]
  workspaces            Workspace[]
  aiCreditBalance       AiCreditBalance?
  aiCreditReservations  AiCreditReservation[]
  aiCreditLedgerEntries AiCreditLedgerEntry[]
  subscription          Subscription?

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  profileId      String
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([organizationId, profileId])
  @@index([organizationId])
  @@index([profileId])
}

model Workspace {
  id             String            @id @default(uuid())
  organizationId String
  name           String
  slug           String
  isDefault      Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  profileId   String
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, profileId])
  @@index([workspaceId])
  @@index([profileId])
}

// ----------------------------------------------------
// AI CREDIT LEDGER ARCHITECTURE (DOUBLE-ENTRY ACCOUNTING)
// ----------------------------------------------------

model AiCreditBalance {
  id                 String       @id @default(uuid())
  organizationId     String       @unique
  monthlyAllowance   Int          @default(50)
  monthlyUsed        Int          @default(0)
  reservedCredits    Int          @default(0)
  purchasedCredits   Int          @default(0)
  billingPeriodStart DateTime     @default(now())
  billingPeriodEnd   DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AiCreditReservation {
  id                String            @id @default(uuid())
  organizationId    String
  userId            String
  operation         String
  requestedCredits  Int
  reservationStatus ReservationStatus @default(RESERVED)
  idempotencyKey    String            @unique
  createdAt         DateTime          @default(now())
  expiresAt         DateTime
  settledAt         DateTime?

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([reservationStatus])
  @@index([expiresAt])
}

model AiCreditLedgerEntry {
  id             String          @id @default(uuid())
  organizationId String
  reservationId  String?
  entryType      LedgerEntryType
  debitAccount   String
  creditAccount  String
  amount         Int
  model          String?
  feature        String?
  inputTokens    Int?
  outputTokens   Int?
  providerCost   Float           @default(0.0)
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([reservationId])
  @@index([entryType])
  @@index([createdAt])
}

// ----------------------------------------------------
// DISTRIBUTED GLOBAL QUOTA CONTROLLER
// ----------------------------------------------------

model AiGlobalQuota {
  id                       String   @id @default("global")
  requestsThisMinute       Int      @default(0)
  tokensThisMinute         Int      @default(0)
  requestsToday            Int      @default(0)
  activeConcurrentRequests Int      @default(0)
  lastResetMinute          DateTime @default(now())
  lastResetDay             DateTime @default(now())
  killSwitchActive         Boolean  @default(false)
  updatedAt                DateTime @updatedAt
}

// ----------------------------------------------------
// DODO PAYMENTS SUBSCRIPTIONS & PAYMENT EVENTS
// ----------------------------------------------------

model Subscription {
  id                 String             @id @default(uuid())
  organizationId     String             @unique
  subscriptionTier   SubscriptionTier   @default(FREE)
  provider           String             @default("dodo")
  dodoSubscriptionId String?            @unique
  dodoCustomerId     String?
  dodoProductId      String?
  status             SubscriptionStatus @default(ACTIVE)
  billingInterval    BillingInterval    @default(MONTHLY)
  cancelAt           DateTime?
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentEvents      PaymentEvent[]

  @@index([organizationId])
  @@index([dodoSubscriptionId])
  @@index([dodoCustomerId])
  @@index([status])
}

model PaymentEvent {
  id             String        @id // Webhook event ID (from webhook-id header)
  subscriptionId String?
  organizationId String?
  eventType      String        // e.g. "subscription.active", "payment.succeeded"
  payload        String        // Full JSON payload
  signatureValid Boolean       @default(true)
  processedAt    DateTime      @default(now())

  subscription   Subscription? @relation(fields: [subscriptionId], references: [dodoSubscriptionId], onDelete: SetNull)

  @@index([subscriptionId])
  @@index([organizationId])
  @@index([eventType])
}
