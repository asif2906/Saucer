# SAUCER — PHASE 1 ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development

# Supabase Authentication & Client (Required for real auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase PostgreSQL Database (Required for Prisma server operations)
# Transaction pooler (Port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (Port 5432) for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Note: In development mode, if Supabase credentials are left empty or placeholder,
# Saucer operates in a safe mock/development session mode allowing full local UI testing.

