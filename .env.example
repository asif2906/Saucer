# SAUCER — ENVIRONMENT VARIABLES
# Copy this file to .env.local for local development

# Supabase Authentication & Client (Project: xfqapdxeladfvivlwltp)
NEXT_PUBLIC_SUPABASE_URL="https://xfqapdxeladfvivlwltp.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase PostgreSQL Database (Required for Prisma server operations)
# Transaction pooler (Port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xfqapdxeladfvivlwltp.supabase.co:6543/postgres?pgbouncer=true"
# Direct connection (Port 5432) for migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xfqapdxeladfvivlwltp.supabase.co:5432/postgres"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dodo Payments (Exclusive Payment Provider - test_mode)
DODO_PAYMENTS_API_KEY="test_dodo_api_key_..."
DODO_PAYMENTS_WEBHOOK_KEY="test_dodo_whsec_..."
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PAYMENTS_RETURN_URL="http://localhost:3000/app/settings/billing"

# Google Gemini Free-Tier (Required for Live AI Studio operations)
# Gemini 3.8 Flash & Gemini 3.5 Flash-Lite (Google AI Studio unpaid tier)
GEMINI_API_KEY=""
